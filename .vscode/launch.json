{
    // Lanzar ESTE PRIMERO y despues la VEMD (desde su propia ventana de VS Code).
    // En el terminal debe salir "listening on udp ...:49350" y, al abrir la
    // VEMD, "link UP - VEMD heard". Para parar: boton de stop o Ctrl+C en el
    // terminal. Solo puede haber un soundsys_host escuchando en el puerto.
    //
    // Requiere la extension C/C++ (ms-vscode.cpptools) para "cppvsdbg".
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Sonido: soundsys_host (Release)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/Release/soundsys_host.exe",
            "args": [
                // Una grabacion por fase: pista al entrar en la fase y bucle
                // mientras dure. No se estira ni se cambia el tono de nada.
                "--phase", "start=${workspaceFolder}/work/phases/start.wav,${workspaceFolder}/work/phases/idle_loop.wav",
                "--phase", "idle=,${workspaceFolder}/work/phases/idle_loop.wav",
                "--phase", "flight=${workspaceFolder}/work/phases/flight_engage.wav,${workspaceFolder}/work/phases/flight_loop.wav",
                "--phase", "takeoff=${workspaceFolder}/work/phases/takeoff.wav,${workspaceFolder}/work/phases/cruise_loop.wav",
                "--phase", "shutdown=${workspaceFolder}/work/phases/shutdown.wav"
                // Mas opciones: "--gain", "0.5", "--record", "sesion.wav", "--bind", "127.0.0.1"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "compilar soundsys_host (Release)"
        },
        {
            // Para poner breakpoints. El audio en Debug va sin optimizar pero
            // sobra CPU; si oyes cortes, usa la Release.
            "name": "Sonido: soundsys_host (Debug)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/bin/Debug/soundsys_host.exe",
            "args": [
                "--phase", "start=${workspaceFolder}/work/phases/start.wav,${workspaceFolder}/work/phases/idle_loop.wav",
                "--phase", "idle=,${workspaceFolder}/work/phases/idle_loop.wav",
                "--phase", "flight=${workspaceFolder}/work/phases/flight_engage.wav,${workspaceFolder}/work/phases/flight_loop.wav",
                "--phase", "takeoff=${workspaceFolder}/work/phases/takeoff.wav,${workspaceFolder}/work/phases/cruise_loop.wav",
                "--phase", "shutdown=${workspaceFolder}/work/phases/shutdown.wav"
            ],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "compilar soundsys_host (Debug)"
        }
    ]
}
